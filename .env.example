# GitHub API Token for fetching repository data
GITHUB_TOKEN=your_github_token_here

# OpenAI API Key for AI-powered features
OPENAI_BASE_URL=your_openai_base_url_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_ID=your_openai_model_id_here


# Database Configuration
DATABASE_PATH=data/tools.db

# Application Base URL (for sitemap generation)
NEXT_PUBLIC_BASE_URL=https://your-project-name.vercel.app

# GitHub Data Fetching Configuration
BATCH_SIZE=8
MAX_RETRIES=5

# Update Mode for fetch-github-data.js script
# 'incremental' (default): Only update Stars/Forks/Issues for existing tools, skip AI re-analysis
# 'full': Force re-run AI analysis for ALL tools (use sparingly, costs more API calls)
UPDATE_MODE=incremental

# Giscus Comment System Configuration
# Get these values from https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=your-username/your-repo
NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDOXXXXX
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOXXXXX

# AdBanner Affiliate Links Configuration
NEXT_PUBLIC_NAMECHEAP_AFFILIATE_ID=your_namecheap_affiliate_id_here
NEXT_PUBLIC_DIGITALOCEAN_PROMO_CODE=your_digitalocean_promo_code_here